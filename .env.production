PORT=4000
NODE_ENV=production

# Database Configuration
# Uncomment the line below for MongoDB Atlas
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/maplorix_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/maplorix_prod

# JWT Configuration
JWT_SECRET=GENERATED_SECURE_RANDOM_STRING_HERE
JWT_EXPIRE=7d

# Email Configuration (CRITICAL for Lead Notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-business-email@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM=info@maplorix.ae

# Frontend Integration
FRONTEND_URL=https://maplorix.ae

# Security & Performance
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880
